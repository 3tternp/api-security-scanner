# ─────────────────────────────────────────────────────────────────────────────
# API Security Scanner — Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in every value before starting the app.
# NEVER commit .env to version control.
#
# NOTE: This app has no authentication — the dashboard and scan APIs are open
# to anyone who can reach the server. Do not expose it to an untrusted network.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ───────────────────────────────────────────────────────────────
ENVIRONMENT=production          # development | production

# ── PostgreSQL (required) ─────────────────────────────────────────────────────
POSTGRES_USER=apiscanner
POSTGRES_PASSWORD=REPLACE_WITH_A_STRONG_DB_PASSWORD
POSTGRES_SERVER=db               # use "localhost" for local dev without Docker
POSTGRES_PORT=5432
POSTGRES_DB=apiscanner

# Deploying to Vercel: one of DATABASE_URL / POSTGRES_URL / the POSTGRES_*
# vars above MUST point at a real, reachable Postgres instance (Vercel
# Postgres, Neon, Supabase, etc). Without it, the backend falls back to
# SQLite at /tmp/app.db, which is a per-invocation, non-persistent path on
# Vercel's serverless runtime — scan results written by one function
# invocation are not guaranteed to be visible to the next.
# DATABASE_URL=postgresql+psycopg2://user:password@host:5432/dbname

# ── CORS origins (comma-separated list as JSON array) ─────────────────────────
BACKEND_CORS_ORIGINS=["http://localhost:5173","https://yourdomain.com"]
